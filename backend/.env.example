DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/documind
# Optional: session-mode / direct URL for Alembic (Supabase pooler). Example:
# DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-….pooler.supabase.com:5432/postgres
JWT_SECRET=change_me_dev_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:5173
STORAGE_PATH=uploads
REDIS_URL=redis://localhost:6379/0
# Set to true to run document ingestion in the API process (no Redis/Celery needed)
RUN_INGEST_INLINE=false
GROQ_API_KEY=gsk_your_groq_key
# Optional: use OpenAI embeddings instead of local FastEmbed
OPENAI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_SUCCESS_URL=http://localhost:5173/app/billing?status=success
STRIPE_CANCEL_URL=http://localhost:5173/app/billing?status=cancel

# Email (Resend)
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=DocuMind <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=false



