DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/documind
# Optional: session-mode / direct URL for Alembic (Supabase pooler). Example:
# DIRECT_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-….pooler.supabase.com:5432/postgres

# Use a long random string in any shared or production environment
JWT_SECRET=dev_only_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:5173
STORAGE_PATH=uploads
REDIS_URL=redis://localhost:6379/0

# Prefer true for local Windows/dev without Redis + Celery
RUN_INGEST_INLINE=true

# Embeddings: default schema is vector(1536) (OpenAI text-embedding-3-small).
# OPENAI_API_KEY is required for that default. Local FastEmbed (384-d) is incompatible
# with the current column unless you change EMBEDDING_DIM and re-migrate/re-embed.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval
RETRIEVAL_TOP_K=12
RETRIEVAL_NEIGHBOR_WINDOW=1
KEYWORD_BACKEND=postgres
# KEYWORD_BACKEND=bm25
HNSW_EF_SEARCH=100
HNSW_OVERFETCH_FACTOR=4

# Stripe billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_SUCCESS_URL=http://localhost:5173/app/billing?status=success
STRIPE_CANCEL_URL=http://localhost:5173/app/billing?status=cancel

# Email / Resend (optional — flows no-op when unset)
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=DocuMind <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=false
