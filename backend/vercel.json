{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{tests/**,.venv/**,uploads/**,**/*.md,.pytest_cache/**}"
    }
  }
}
